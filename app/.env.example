# Copy this file to ".env" and fill in real values.
# .env is git-ignored; .env.example is committed as documentation.

# Google Maps API key — used for ETA/Directions and the native (phone) map.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# The deployed mailer's URL — the worker that holds the SendGrid key and sends
# the "your cab has been assigned" email. See ../../mailer/README.md.
# Leave it blank and the app works exactly as before: in-app notifications still
# appear, and email jobs queue in Firestore unsent instead of being lost.
# NOT a secret (EXPO_PUBLIC_* is inlined into the shipped bundle) — the endpoint
# is safe to be public; Firestore rules are what authorise a send.
EXPO_PUBLIC_MAILER_URL=https://cab-mailer.your-subdomain.workers.dev

# The domain a driver's synthesized Firebase Auth address is built on — drivers
# sign in with a numeric code, not an email, and this is where the address that
# code stands for lives (see app/src/utils/driverLogin.js).
#
# LEAVE THIS UNSET unless you have to. The default, "driver.cab.invalid", uses a
# TLD reserved by RFC 2606 that can never resolve, so if Firebase ever tries to
# mail one of these accounts it cannot reach a real person. Only set it if a
# Firebase project refuses the address format, and then use a subdomain of a
# domain you own.
#
# CHANGING IT AFTER DRIVERS EXIST BREAKS THEIR LOGINS — the address is the
# account. Every existing driver would have to be deleted and re-added.
# EXPO_PUBLIC_DRIVER_LOGIN_DOMAIN=driver.yourcompany.com
